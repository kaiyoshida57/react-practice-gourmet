{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": true,
    "types": ["@vercel/node"],
    "skipLibCheck": true,
    "outDir": "dist",
  },
  "include": ["server", "src"]
}
